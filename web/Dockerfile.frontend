# syntax=docker/dockerfile:1

ARG NEXT_PUBLIC_NOF1_API_BASE_URL=/api/nof1
ARG NEXT_PUBLIC_TICKER_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT

FROM node:20-bookworm AS base
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

FROM base AS deps
ARG NEXT_PUBLIC_NOF1_API_BASE_URL
ARG NEXT_PUBLIC_TICKER_PAIRS
ENV NEXT_PUBLIC_NOF1_API_BASE_URL=${NEXT_PUBLIC_NOF1_API_BASE_URL}
ENV NEXT_PUBLIC_TICKER_PAIRS=${NEXT_PUBLIC_TICKER_PAIRS}
COPY package.json package-lock.json* ./
RUN npm ci --include=dev

FROM deps AS build
ARG NEXT_PUBLIC_NOF1_API_BASE_URL
ARG NEXT_PUBLIC_TICKER_PAIRS
ENV NEXT_PUBLIC_NOF1_API_BASE_URL=${NEXT_PUBLIC_NOF1_API_BASE_URL}
ENV NEXT_PUBLIC_TICKER_PAIRS=${NEXT_PUBLIC_TICKER_PAIRS}
COPY . .
RUN npm run build

FROM node:20-bookworm-slim AS runner
ARG NEXT_PUBLIC_NOF1_API_BASE_URL
ARG NEXT_PUBLIC_TICKER_PAIRS
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_NOF1_API_BASE_URL=${NEXT_PUBLIC_NOF1_API_BASE_URL}
ENV NEXT_PUBLIC_TICKER_PAIRS=${NEXT_PUBLIC_TICKER_PAIRS}
WORKDIR /app

# Copy built output (Next "standalone" bundle) and static assets
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

EXPOSE 3000
ENV PORT=3000
ENV HOST=0.0.0.0

CMD ["node", "server.js"]
